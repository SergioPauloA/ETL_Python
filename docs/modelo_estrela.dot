digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.5, ranksep=1.1, fontname="Helvetica", bgcolor="white", pad=0.3];
  node  [shape=plain, fontname="Helvetica", fontsize=11];
  edge  [color="#444444", arrowhead=none, penwidth=1.4];

  fato [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FDEBD0">
    <TR><TD BGCOLOR="#E67E22" COLSPAN="2"><FONT COLOR="white"><B>fact_vendas</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">sk_venda</TD></TR>
    <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">sk_tempo</TD></TR>
    <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">sk_produto</TD></TR>
    <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">sk_cliente</TD></TR>
    <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">sk_territorio</TD></TR>
    <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">sk_vendedor</TD></TR>
    <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">sk_oferta</TD></TR>
    <TR><TD ALIGN="LEFT"><B>DD</B></TD><TD ALIGN="LEFT">id_pedido, id_item_pedido</TD></TR>
    <TR><TD ALIGN="LEFT"><B>DD</B></TD><TD ALIGN="LEFT">venda_online</TD></TR>
    <TR><TD ALIGN="LEFT"><I>M</I></TD><TD ALIGN="LEFT">quantidade</TD></TR>
    <TR><TD ALIGN="LEFT"><I>M</I></TD><TD ALIGN="LEFT">preco_unitario, pct_desconto</TD></TR>
    <TR><TD ALIGN="LEFT"><I>M</I></TD><TD ALIGN="LEFT">valor_bruto, valor_desconto</TD></TR>
    <TR><TD ALIGN="LEFT"><I>M</I></TD><TD ALIGN="LEFT">valor_liquido, custo_total</TD></TR>
  </TABLE>>];

  tempo [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBF5FB">
    <TR><TD BGCOLOR="#2E86C1" COLSPAN="2"><FONT COLOR="white"><B>dim_tempo</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">sk_tempo (AAAAMMDD)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">data, ano, semestre</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">trimestre, mes, nome_mes</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">ano_mes, dia, dia_semana</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">nome_dia_semana</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">fim_de_semana</TD></TR>
  </TABLE>>];

  produto [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBF5FB">
    <TR><TD BGCOLOR="#2E86C1" COLSPAN="2"><FONT COLOR="white"><B>dim_produto</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">sk_produto</TD></TR>
    <TR><TD ALIGN="LEFT"><B>NK</B></TD><TD ALIGN="LEFT">id_produto</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">nome, numero_produto, cor</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">custo_padrao, preco_lista</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">subcategoria, categoria</TD></TR>
  </TABLE>>];

  cliente [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBF5FB">
    <TR><TD BGCOLOR="#2E86C1" COLSPAN="2"><FONT COLOR="white"><B>dim_cliente</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">sk_cliente</TD></TR>
    <TR><TD ALIGN="LEFT"><B>NK</B></TD><TD ALIGN="LEFT">id_cliente</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">tipo_cliente, nome_cliente</TD></TR>
  </TABLE>>];

  territorio [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBF5FB">
    <TR><TD BGCOLOR="#2E86C1" COLSPAN="2"><FONT COLOR="white"><B>dim_territorio</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">sk_territorio</TD></TR>
    <TR><TD ALIGN="LEFT"><B>NK</B></TD><TD ALIGN="LEFT">id_territorio</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">nome_territorio</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">codigo_pais, grupo</TD></TR>
  </TABLE>>];

  vendedor [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBF5FB">
    <TR><TD BGCOLOR="#2E86C1" COLSPAN="2"><FONT COLOR="white"><B>dim_vendedor</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">sk_vendedor</TD></TR>
    <TR><TD ALIGN="LEFT"><B>NK</B></TD><TD ALIGN="LEFT">id_vendedor</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">nome_vendedor, cota_vendas</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">bonus, pct_comissao</TD></TR>
  </TABLE>>];

  oferta [label=<
  <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EBF5FB">
    <TR><TD BGCOLOR="#2E86C1" COLSPAN="2"><FONT COLOR="white"><B>dim_oferta_especial</B></FONT></TD></TR>
    <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">sk_oferta</TD></TR>
    <TR><TD ALIGN="LEFT"><B>NK</B></TD><TD ALIGN="LEFT">id_oferta</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">descricao, pct_desconto</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">tipo, categoria</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">data_inicio, data_fim</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">qtd_minima, qtd_maxima</TD></TR>
  </TABLE>>];

  {rank=same; tempo; produto; cliente}
  {rank=same; territorio; vendedor; oferta}
  tempo -> fato; produto -> fato; cliente -> fato;
  fato -> territorio; fato -> vendedor; fato -> oferta;
}
