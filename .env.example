# Este arquivo NÃO contém login nem senha.
# As credenciais dos bancos ficam nas CONEXÕES NOMEADAS do Apache Airflow
# (aw_oltp e dw_postgres), cadastradas no próprio Airflow (docker-compose cria
# automaticamente;).
#
# O .env está no .gitignore. Variável opcional (somente Linux/macOS):
AIRFLOW_UID=50000
